# Environnement d'exécution (development, production, testing)
FLASK_ENV=development
FLASK_DEBUG=1

# Configuration de l'application
SECRET_KEY=change-me-in-production
HOST=0.0.0.0
PORT=5000

# Configuration de la base de données
# Utilisez ce format pour SQLite (chemin relatif au dossier instance)
DATABASE_URL=sqlite:///educinfo.db
# Utilisez ce format pour PostgreSQL ou MySQL en production
# DATABASE_URL=postgresql://user:password@localhost:5432/educinfo
# DATABASE_URL=mysql://user:password@localhost:3306/educinfo

# Configuration admin
DEFAULT_ADMIN_EMAIL=admin@educinfo.com
DEFAULT_ADMIN_PASSWORD=admin123

# API météo (OpenWeather)
WEATHER_API_KEY=your-api-key-here
WEATHER_CITY=Strasbourg

# API transports (CTS)
CTS_BASE_URL=https://api.cts-strasbourg.eu
CTS_API_TOKEN=your-cts-api-token-here

# Configuration des logs
LOG_LEVEL=INFO