# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Port HTTP exposé par Docker.
APP_PORT=5001
# false autorise l'accès HTTP local ; utiliser true derrière HTTPS.
SESSION_COOKIE_SECURE=false
ADMIN_USERNAME=admin
# Si vide au premier lancement, le mot de passe généré est affiché une seule fois dans les logs.
ADMIN_PASSWORD=
WEATHER_API_KEY=
WEATHER_CITY=Strasbourg
CTS_API_TOKEN=
DEMO_MODE=false
