# ==============================================================================
# EDUCINFO - CONFIGURATION INSTANCE UNIQUE (DÉVELOPPEMENT ET PETITE PRODUCTION)
# ==============================================================================
# 
# Ce fichier configure EducInfo pour une instance unique (non load-balancée).
# Idéal pour : développement, tests, petites installations (1-50 utilisateurs).
# 
# Pour un déploiement cluster load-balancé, utilisez .env.cluster.example
#
# Instructions :
# 1. Copier ce fichier : cp .env.example .env
# 2. Modifier les valeurs selon vos besoins
# 3. Démarrer : docker-compose up -d ou python run.py
#
# ==============================================================================

# ==============================================================================
# 🔧 CONFIGURATION FLASK DE BASE
# ==============================================================================

# Environnement d'exécution
FLASK_ENV=development                # development, production, testing
FLASK_DEBUG=1                       # 1 pour activer le debug (dev uniquement)

# Application
APP_NAME=EducInfo
APP_VERSION=2.0.0
HOST=0.0.0.0
PORT=5000

# Sécurité (IMPORTANT : changer en production)
SECRET_KEY=change-me-in-production-please
WTF_CSRF_ENABLED=true
WTF_CSRF_TIME_LIMIT=3600            # 1 heure

# ==============================================================================
# 💾 BASE DE DONNÉES
# ==============================================================================

# SQLite pour développement (fichier local dans instance/)
DATABASE_URL=sqlite:///educinfo.db

# Alternatives pour production :
# PostgreSQL (recommandé) :
# DATABASE_URL=postgresql://user:password@localhost:5432/educinfo

# MySQL :
# DATABASE_URL=mysql://user:password@localhost:3306/educinfo

# Pool de connexions (pour PostgreSQL/MySQL uniquement)
# DB_POOL_SIZE=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_MAX_OVERFLOW=10

# ==============================================================================
# 👤 ADMINISTRATION
# ==============================================================================

# Compte administrateur par défaut
DEFAULT_ADMIN=admin
DEFAULT_ADMIN_PASSWORD=             # Laissez vide pour générer automatiquement un mot de passe sécurisé

# ==============================================================================
# 🌤️ APIS EXTERNES
# ==============================================================================

# API Météo - OpenWeatherMap (optionnel)
# Obtenir une clé : https://openweathermap.org/api
WEATHER_API_KEY=your-openweather-api-key-here
WEATHER_CITY=Strasbourg

# API Transport - CTS Strasbourg (optionnel)
# Demander un token : https://www.cts-strasbourg.eu/fr/se-deplacer/opendata/
CTS_BASE_URL=https://api.cts-strasbourg.eu
CTS_API_TOKEN=your-cts-api-token-here
CTS_MAX_VISITS=8                    # Nombre de prochains passages affichés
CTS_PREVIEW_INTERVAL=PT90M          # Horizon de prévision (format ISO 8601, ex: PT30M, PT2H)

# ==============================================================================
# 🚀 PERFORMANCE ET CACHE
# ==============================================================================

# Type de cache
CACHE_TYPE=simple                   # simple, filesystem, redis
CACHE_DEFAULT_TIMEOUT=300           # 5 minutes
CACHE_KEY_PREFIX=educinfo_

# Timeouts spécialisés par service
WEATHER_CACHE_TIMEOUT=1800          # 30 minutes - données météo
CTS_CACHE_TIMEOUT=60                # 1 minute - transports temps réel
MENU_CACHE_TIMEOUT=3600             # 1 heure - menus cantine
CONFIG_CACHE_TIMEOUT=7200           # 2 heures - configuration
STATS_CACHE_TIMEOUT=300             # 5 minutes - statistiques

# ==============================================================================
# 📊 MONITORING ET MÉTRIQUES
# ==============================================================================

# Health check
HEALTH_CHECK_PATH=/health

# Métriques système (CPU, RAM, disque)
PSUTIL_ENABLED=true                 # Activer les métriques système

# Métriques Prometheus (optionnel)
PROMETHEUS_METRICS_ENABLED=false   # Activer pour monitoring avancé
PROMETHEUS_METRICS_PATH=/metrics

# ==============================================================================
# 🔒 SÉCURITÉ
# ==============================================================================

# Sessions
SESSION_COOKIE_HTTPONLY=true       # Protection XSS
SESSION_COOKIE_SAMESITE=Lax        # Protection CSRF
PERMANENT_SESSION_LIFETIME=86400    # 24 heures

# HTTPS (production)
# FORCE_HTTPS=true                  # Forcer HTTPS en production
# SESSION_COOKIE_SECURE=true       # Cookies HTTPS uniquement

# ==============================================================================
# 📝 LOGGING
# ==============================================================================

# Niveau de logs
LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Rotation des logs (optionnel)
# LOG_MAX_BYTES=10485760            # 10MB par fichier
# LOG_BACKUP_COUNT=5                # Garder 5 fichiers

# ==============================================================================
# 🌍 LOCALISATION
# ==============================================================================

# Fuseau horaire
TIMEZONE=Europe/Paris

# ==============================================================================
# 📚 EXEMPLES DE COMMANDES
# ==============================================================================

# Démarrer en développement :
# python run.py

# Démarrer avec Docker :
# docker-compose up -d

# Initialiser la base de données :
# flask db upgrade
# flask init-db

# Créer un utilisateur admin :
# flask add-user --username admin --password newpass --admin

# ==============================================================================