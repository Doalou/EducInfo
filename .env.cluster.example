# EducInfo - Configuration Cluster Load Balancé
# Pour utilisation avec docker-compose.cluster.yml
# Copier vers .env.cluster et ajuster les valeurs

# ==============================================
# CONFIGURATION DE BASE
# ==============================================

FLASK_ENV=production
FLASK_DEBUG=0
APP_NAME=EducInfo  
APP_VERSION=2.0.0
HOST=0.0.0.0
PORT=5000

# Sécurité (OBLIGATOIRE - changer en production)
SECRET_KEY=your-super-secret-cluster-key-change-this-in-production
CSRF_SECRET_KEY=your-csrf-secret-key-change-this-too

# ==============================================
# CLUSTER OBLIGATOIRE
# ==============================================

# Redis Cache Partagé (REQUIS pour cluster)
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=                     # Définissez un mot de passe sécurisé

# PostgreSQL Partagé (REQUIS pour cluster)
DATABASE_URL=postgresql://educinfo:YOUR_PASSWORD@db:5432/educinfo
POSTGRES_USER=educinfo
POSTGRES_PASSWORD=                  # Définissez un mot de passe sécurisé
POSTGRES_DB=educinfo

# ==============================================
# MÉTRIQUES CLUSTER
# ==============================================

# Configuration des métriques cluster
METRICS_INSTANCE_TTL=300          # TTL des métriques d'instance (5 minutes)
METRICS_UPDATE_INTERVAL=60        # Fréquence de mise à jour (1 minute)

# Health check et métriques
HEALTH_CHECK_PATH=/health
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics
PSUTIL_ENABLED=true

# ==============================================
# APIs EXTERNES
# ==============================================

# API météo (OpenWeather)
WEATHER_API_KEY=your-openweather-key-here
WEATHER_CITY=Strasbourg

# API transports (CTS)
CTS_BASE_URL=https://api.cts-strasbourg.eu
CTS_API_TOKEN=your-cts-token-here

# Configuration admin
DEFAULT_ADMIN=admin
DEFAULT_ADMIN_PASSWORD=             # Laissez vide pour générer automatiquement un mot de passe sécurisé

# ==============================================
# PERFORMANCE CLUSTER
# ==============================================

# Cache Redis
CACHE_TYPE=RedisCache
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=educinfo_cluster_

# Timeouts spécialisés
WEATHER_CACHE_TIMEOUT=1800       # 30 minutes
CTS_CACHE_TIMEOUT=60             # 1 minute  
MENU_CACHE_TIMEOUT=3600          # 1 heure
CONFIG_CACHE_TIMEOUT=7200        # 2 heures
STATS_CACHE_TIMEOUT=300          # 5 minutes

# Base de données PostgreSQL
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_MAX_OVERFLOW=20

# ==============================================
# SÉCURITÉ PRODUCTION
# ==============================================

# Headers de sécurité
FORCE_HTTPS=false               # true avec SSL/TLS
SESSION_COOKIE_SECURE=false    # true avec HTTPS
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Protection CSRF
WTF_CSRF_ENABLED=true
WTF_CSRF_TIME_LIMIT=3600         # 1 heure

# Sessions
PERMANENT_SESSION_LIFETIME=86400  # 24 heures

# ==============================================
# MONITORING AVANCÉ
# ==============================================

# Logging
LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR
LOG_MAX_BYTES=10485760           # 10MB
LOG_BACKUP_COUNT=5

# Load Balancer (utilisé par Nginx)
LB_HEALTH_CHECK_INTERVAL=30      # Intervalle health check (secondes)
LB_FAIL_TIMEOUT=30               # Timeout avant marquage failed
LB_MAX_FAILS=3                   # Nb d'échecs avant marquage failed

# Découverte d'instances
INSTANCE_DISCOVERY_ENABLED=true
INSTANCE_HEARTBEAT_INTERVAL=60   # Heartbeat toutes les 60 secondes

# ==============================================
# REDIS AVANCÉ
# ==============================================

# Configuration Redis détaillée
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_CONNECTION_POOL_MAX_CONNECTIONS=50
REDIS_RETRY_ON_TIMEOUT=true

# ==============================================
# CONFIGURATION DOCKER COMPOSE
# ==============================================

# Variables utilisées par docker-compose.cluster.yml
COMPOSE_PROJECT_NAME=educinfo-cluster

# Limites de ressources (optionnel)
MEM_LIMIT=512m
CPU_LIMIT=1.0

# ==============================================
# CONFIGURATION OPTIONNELLE
# ==============================================

# Timezone
TIMEZONE=Europe/Paris

# Debug et développement
SQLALCHEMY_ECHO=false            # true pour voir les requêtes SQL
EXPLAIN_TEMPLATE_LOADING=false

# ==============================================
# NOTES IMPORTANTES
# ==============================================

# 1. REDIS_URL est OBLIGATOIRE pour le mode cluster
# 2. Utiliser PostgreSQL en production (plus robuste que SQLite)
# 3. Changer TOUS les mots de passe en production
# 4. Activer HTTPS en production (FORCE_HTTPS=true)
# 5. Sauvegarder régulièrement la base de données
# 6. Surveiller les métriques via /admin/metrics

# ==============================================
# EXEMPLE DE COMMANDES
# ==============================================

# Démarrer le cluster :
# ./scripts/cluster.sh
# make cluster

# Surveiller le cluster :
# make cluster-status
# ./scripts/cluster.sh --logs

# Arrêter le cluster :
# make cluster-stop
# ./scripts/cluster.sh --stop 